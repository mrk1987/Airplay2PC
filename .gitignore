# Only explicitly reviewed source files are tracked.
*
!.gitignore
!README.md
!assets/
!assets/icons/
!assets/icons/Airplay2PC-logo.png
!assets/icons/Airplay2PC-logo.ico
!assets/icons/Airplay2PC-icon.png
!assets/icons/Airplay2PC-icon.ico
!assets/banner.png
!assets/banner-prompt.md
!assets/icons/README.md
!Start-Airplay.ps1
!Start-Tray.ps1
!Install-Tray.ps1
!requirements-tray.txt
!tray_app/
!tray_app/*.py
!Test-Airplay.ps1
!requirements-windows.txt
!tests/
!tests/test_*.py
!patches/
!patches/*.patch
!tools/
!tools/probe_ptp.py
!tools/replay_timing.py
!timing/
!timing/__init__.py
!timing/timeline.py
!timing/ptp.py
!timing/anchors.py
!timing/follower.py
!timing/scheduler.py
!timing/diagnostics.py
!timing/output_clock.py
!timing/clock.py
!timing/output_delay.py
!docs/timing-research/
!docs/timing-research/*.md
!.gitattributes
!docs/
!docs/*.md
!LICENSE
!THIRD_PARTY.md
!CHANGELOG.md
!SECURITY.md
!VERSION
!requirements-release.txt
!packaging/
!packaging/*.py
!packaging/*.ps1
!packaging/*.cmd
!.github/
!.github/workflows/
!.github/workflows/*.yml

# Private and generated material stays ignored even inside source folders.
**/.env
**/.env.*
**/*.pem
**/*.p12
**/__pycache__/
**/*.pyc
