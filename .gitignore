# Only explicitly reviewed source files are tracked.
*
!.gitignore
!README.md
!assets/
!assets/icons/
!assets/icons/airplay-audio.png
!assets/icons/airplay-audio.ico
!assets/icons/airplay-audio-white.png
!assets/icons/airplay-audio-white.ico
!assets/icons/README.md
!Start-Airplay.ps1
!Start-Tray.ps1
!Install-Tray.ps1
!requirements-tray.txt
!tray_app/
!tray_app/*.py
!Test-Airplay.ps1
!requirements-windows.txt
!tests/
!tests/test_*.py
!patches/
!patches/*.patch
!tools/
!tools/probe_ptp.py
!tools/replay_timing.py
!timing/
!timing/__init__.py
!timing/timeline.py
!timing/ptp.py
!timing/anchors.py
!timing/follower.py
!timing/scheduler.py
!timing/diagnostics.py
!timing/output_clock.py
!timing/clock.py
!docs/timing-research/
!docs/timing-research/*.md
!.gitattributes
!docs/
!docs/*.md

# Private and generated material stays ignored even inside source folders.
**/.env
**/.env.*
**/*.pem
**/*.p12
**/__pycache__/
**/*.pyc
